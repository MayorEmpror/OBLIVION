      ],
      "id": "4d1bda27-5628-4ced-a5fd-02aa25400dc1",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(i => {\n  const h = i.json;\n  return { json: {\n    source: 'hackernews',\n    external_id: 'hn_' + h.objectID,\n    community: 'HN',\n    title: h.story_title || h.title || '',\n    body: (h.comment_text || h.story_text || '')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/&#x27;/g, \"'\")\n      .replace(/&quot;/g, '\"')\n      .replace(/&amp;/g, '&')\n      .replace(/&gt;/g, '>')\n      .replace(/&lt;/g, '<')\n      .replace(/&#x2F;/g, '/')\n      .replace(/\\s+/g, ' ')\n      .trim(),\n    url: 'https://news.ycombinator.com/item?id=' + h.objectID,\n    author_hash: h.author || '',\n    created_at: h.created_at\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -192
      ],
      "id": "72d26ef6-8c48-42cc-a533-5a4bd8fd55ac",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "fieldToSplitOut": "hits",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        160,
        -192
      ],
      "id": "86c2763b-1426-425f-9c6b-180e2407a173",
      "name": "Split Out"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate every transformed finding into ONE item so the HTTP Request node\n// below runs exactly once and sends the whole batch in a single authenticated\n// request. `$workflow.id` / `$execution.id` travel with the batch as\n// provenance so every stored row can be traced back to this run.\nconst items = $input.all().map((item) => item.json);\n\nreturn [\n  {\n    json: {\n      workflow_id: $workflow.id,\n      execution_id: $execution.id,\n      items,\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -192
      ],
      "id": "a7d1e4b2-5c93-4f18-8e0a-6b2c9d4f1a01",
      "name": "Build ingestion payload"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OBLIVION_INGEST_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        -192
      ],
      "id": "a7d1e4b2-5c93-4f18-8e0a-6b2c9d4f1a02",
      "name": "POST findings to OBLIVION",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Sends the batch to the Next.js ingestion API, which persists it to PostgreSQL and publishes a realtime event. Authenticates with the shared secret from the n8n container's N8N_WEBHOOK_SECRET env var. Retries are bounded (3 tries) and safe because the endpoint is idempotent on external_id."
    },
