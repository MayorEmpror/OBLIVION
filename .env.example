# ─── OBLIVION environment template ────────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in real values.
#   cp .env.example .env
#
# NEVER commit `.env`, `.env.local`, or real secrets. Values here are placeholders.

# ── Research database (PostgreSQL) ───────────────────────────────────────────
# Server-only. Consumed by lib/db.ts via node-postgres.
# The local dev database runs in the `research-db` container (pgvector/pg16):
#   docker run --name research-db -e POSTGRES_USER=research \
#     -e POSTGRES_PASSWORD=... -e POSTGRES_DB=research \
#     -v research_pgdata:/var/lib/postgresql/data -p 5432:5432 -d pgvector/pgvector:pg16
DATABASE_URL="postgresql://research:YOUR_DB_PASSWORD@localhost:5432/research"

# Optional: max size of the node-postgres connection pool (default 10).
# PGPOOL_MAX=10

# ── n8n result ingestion ─────────────────────────────────────────────────────
# Shared secret n8n must send on the `x-n8n-secret` header (or as
# `Authorization: Bearer <secret>`) when POSTing to /api/n8n/results.
# Server-only — NEVER prefix this with NEXT_PUBLIC_.
# Generate one with:  openssl rand -hex 32
N8N_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# URL n8n uses to reach the ingestion endpoint. Only read by the n8n workflow
# (as `$env.OBLIVION_INGEST_URL`), not by the Next.js app.
#
#   n8n in Docker  ->  Next.js on the macOS host : http://host.docker.internal:3000/api/n8n/results
#   both in Docker (shared network)              : http://oblivion:3000/api/n8n/results
#   both in Docker (host-published port)         : http://host.docker.internal:3000/api/n8n/results
#   deployed (public hostname)                   : https://your-app.example.com/api/n8n/results
#
# `localhost` inside the n8n container is the container, NOT your Mac.
OBLIVION_INGEST_URL="http://host.docker.internal:3000/api/n8n/results"
